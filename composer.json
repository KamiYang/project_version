{
  "name": "kamiyang/ext-projectversion",
  "type": "typo3-cms-extension",
  "description": "Displays current project version based on 'VERSION' file or GIT revision.",
  "homepage": "https://github.com/KamiYang/project_version",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "TYPO3 CMS",
    "typo3",
    "GIT",
    "git",
    "version"
  ],
  "authors": [
    {
      "name": "Jan Stockfisch",
      "email": "jan@jan-stockfisch.de",
      "homepage": "https://jan-stockfisch.de/"
    }
  ],
  "replace": {
    "kamiyang/project_version": "self.version"
  },
  "require": {
    "php": "^8.2",
    "typo3/cms-backend": "^13.4 || ^14.0 || ^15.0",
    "typo3/cms-core": "^13.4 || ^14.0 || ^15.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.0",
    "typo3/coding-standards": "^0.9",
    "typo3/testing-framework": "^9.6 || ^10.0"
  },
  "autoload": {
    "psr-4": {
      "KamiYang\\ProjectVersion\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KamiYang\\ProjectVersion\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@link-extension"
    ],
    "link-extension": [
      "mkdir -p .Build/public/typo3conf/ext",
      "[ -e .Build/public/typo3conf/ext/project_version ] || ln -snf ../../../../. .Build/public/typo3conf/ext/project_version"
    ],
    "ci:lint": "find Classes Configuration Tests ext_emconf.php -name '*.php' -print0 | xargs -0 -n1 -P4 php -l -d display_errors=stderr > /dev/null",
    "ci:cs": "php-cs-fixer fix --dry-run --diff",
    "ci:phpstan": "phpstan analyse --no-progress",
    "ci:test": "phpunit -c phpunit.xml",
    "ci": [
      "@ci:lint",
      "@ci:cs",
      "@ci:phpstan",
      "@ci:test"
    ],
    "fix:cs": "php-cs-fixer fix"
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "sort-packages": true,
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "project_version",
      "version": "2.0.0",
      "Package": {
        "providesPackages": {}
      },
      "web-dir": ".Build/public"
    }
  }
}
